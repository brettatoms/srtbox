{
  "_denyEnv": ["*TOKEN*", "*_KEY", "*_SECRET", "*PASSWORD*"],
  "_mkdir": ["${XDG_RUNTIME_DIR}/clojure-mcp-light"],
  "_inject": {
    "GH_TOKEN": {"from": "gh auth token", "hosts": ["api.github.com", "github.com", "uploads.github.com"]},
    "CLAUDE_CODE_OAUTH_TOKEN": {"from": "secret-tool lookup service srtbox-claude-token", "hosts": ["api.anthropic.com"]}
  },
  "credentials": {"files": [{"path": "~/.claude/.credentials.json", "mode": "deny"}]},

  "network": {
    "allowedDomains": [
      "api.anthropic.com",
      "claude.ai",
      "github.com",
      "*.github.com",
      "*.actions.githubusercontent.com",
      "registry.npmjs.org"
    ],
    "allowAllUnixSockets": true
  },

  "filesystem": {
    "denyRead": ["~", "${XDG_RUNTIME_DIR}/bus", "${XDG_RUNTIME_DIR}/keyring"],
    "allowRead": ["~/.claude", "~/.claude.json", "~/.gitconfig", "~/.config/git", "~/.local/bin"],
    "allowWrite": ["/tmp", "~/.claude", "~/.claude.json", "${XDG_RUNTIME_DIR}/clojure-mcp-light"]
  }
}
